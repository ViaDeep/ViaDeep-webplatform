# DOMAIN viene del .env del servidor (por ejemplo viadeep-tesis.eastus.cloudapp.azure.com).
# Caddy obtiene y renueva solo el certificado https.

{$DOMAIN:localhost} {
	encode gzip

	handle /auth* {
		reverse_proxy auth:8081
	}
	handle /incidents* {
		reverse_proxy incidents:8082
	}
	handle /evidences* {
		reverse_proxy evidences:8083
	}
	handle /notifications* {
		reverse_proxy notifications:8084
	}

	# La web es una SPA: cualquier otra ruta devuelve index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Descarga de las fotos (URLs firmadas por el servicio de evidencias), con el mismo certificado.
{$DOMAIN:localhost}:9443 {
	reverse_proxy storage:9090
}
